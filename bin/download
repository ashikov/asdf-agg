#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(cd "$(dirname "$current_script_path")/.." && pwd)
install_type=${ASDF_INSTALL_TYPE:-}
version=${ASDF_INSTALL_VERSION:-}
download_path=${ASDF_DOWNLOAD_PATH:-}
temporary_binary=
detected_os=
detected_architecture=
detected_libc=

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

require_value ASDF_INSTALL_TYPE "$install_type"
require_value ASDF_INSTALL_VERSION "$version"
require_value ASDF_DOWNLOAD_PATH "$download_path"

if [ "$install_type" != "version" ]; then
	fail "release installs only; ASDF_INSTALL_TYPE was '$install_type'"
fi

validate_release_version "$version"
detected_os=$(uname -s)
detected_architecture=$(uname -m)
detected_libc=$(detect_libc "$detected_os" "$detected_architecture")
mkdir -p "$download_path"
temporary_binary=$(mktemp "${download_path}/.agg.XXXXXX") || fail "could not create download staging file"

cleanup_download() {
	if [ -n "$temporary_binary" ] && [ -e "$temporary_binary" ]; then
		rm -f "$temporary_binary"
	fi
}
trap cleanup_download EXIT

download_release "$version" "$temporary_binary" "$detected_os" "$detected_architecture" "$detected_libc"
chmod 755 "$temporary_binary"
verify_agg_binary "$temporary_binary" "$version"

mv "$temporary_binary" "${download_path}/agg"
temporary_binary=
trap - EXIT
