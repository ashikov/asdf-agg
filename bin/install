#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(cd "$(dirname "$current_script_path")/.." && pwd)
install_type=${ASDF_INSTALL_TYPE:-}
version=${ASDF_INSTALL_VERSION:-}
download_path=${ASDF_DOWNLOAD_PATH:-}
install_path=${ASDF_INSTALL_PATH:-}

# shellcheck source=../lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

require_value ASDF_INSTALL_TYPE "$install_type"
require_value ASDF_INSTALL_VERSION "$version"
require_value ASDF_DOWNLOAD_PATH "$download_path"
require_value ASDF_INSTALL_PATH "$install_path"

install_version "$install_type" "$version" "$download_path" "$install_path"
